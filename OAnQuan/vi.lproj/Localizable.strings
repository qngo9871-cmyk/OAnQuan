"rules.title" = "Luật Đầy Đủ";
"rules.done" = "Xong";
"rules.variant.title" = "Ô Ăn Quan (quan 10 điểm)";
"rules.variant.body" = "Ứng dụng này dùng quy ước phổ biến: quân quan lớn ở mỗi ô Quan có giá trị 10 điểm khi tính điểm cuối ván. Một số nguồn khác dùng giá trị khác — đây là giá trị mà ứng dụng này dùng, nhất quán trong toàn bộ trò chơi.";
"rules.setup.title" = "Bàn Cờ";
"rules.setup.body" = "Bàn cờ gồm 12 ô xếp thành vòng tròn: 2 ô Quan lớn ở hai đầu, và 10 ô dân nhỏ chia đều 5 ô cho mỗi người chơi. Mỗi ô dân bắt đầu với 5 quân; mỗi ô Quan bắt đầu với 1 quân quan lớn trị giá 10 điểm.";
"rules.sowing.title" = "Rải Quân";
"rules.sowing.body" = "Đến lượt, bạn nhặt hết quân trong một ô dân của mình (còn quân). Chọn hướng rải — theo chiều kim đồng hồ hoặc ngược lại — rồi rải mỗi ô một quân dọc theo vòng, kể cả các ô Quan nếu đi ngang qua.";
"rules.capture.title" = "Ăn Quân";
"rules.capture.body" = "Rải xong, xem ô ngay sau quân cuối cùng. Nếu ô đó trống, xem tiếp ô sau nữa — nếu có quân, bạn ăn hết số quân đó. Cứ như vậy: hễ một ô trống theo sau là một ô có quân thì được ăn tiếp. Chuỗi ăn dừng lại khi gặp hai ô trống liên tiếp, hoặc gặp một ô Quan (ô Quan không bao giờ bị ăn theo cách này).";
"rules.borrow.title" = "Mượn Quân";
"rules.borrow.body" = "Nếu cả 5 ô dân của bạn đều trống khi đến lượt bạn, đối thủ phải cho bạn mượn 1 quân từ số quân đã ăn được, rải vào mỗi ô trong 5 ô của bạn. Nếu đối thủ không đủ ít nhất 5 quân để cho mượn, ván đấu kết thúc ngay lập tức.";
"rules.scoring.title" = "Tính Điểm & Kết Thúc";
"rules.scoring.body" = "Ván đấu cũng kết thúc nếu cả hai hàng của hai người chơi cùng trống một lúc. Quân còn lại trong các ô Quan (quân quan 10 điểm cộng với quân dân đã rải vào) thuộc về chủ ô đó. Quân còn lại trong ô dân bị bỏ, không tính điểm. Ai có tổng số quân ăn được nhiều hơn sẽ thắng — bằng điểm thì hòa.";

"onboarding.page1.title" = "Bàn Cờ";
"onboarding.page1.body" = "Ô Ăn Quan là trò chơi dân gian truyền thống của Việt Nam. Bàn cờ có 12 ô xếp vòng tròn: 5 ô dân của bạn, 5 ô dân của đối thủ, và một ô Quan lớn ở mỗi đầu.";
"onboarding.page2.title" = "Nhặt Quân & Rải";
"onboarding.page2.body" = "Chạm vào một ô dân của bạn (còn quân) để nhặt hết quân trong đó, rồi chọn hướng rải. Bạn rải mỗi ô một quân dọc theo vòng.";
"onboarding.page3.title" = "Ăn Quân";
"onboarding.page3.body" = "Nếu ô ngay sau quân cuối cùng trống, và ô kế tiếp sau đó có quân, bạn ăn được số quân đó! Chuỗi ăn tiếp tục qua các cặp trống-rồi-có-quân — gặp ô Quan hoặc hai ô trống liên tiếp thì dừng lại.";
"onboarding.page4.title" = "Mượn Quân & Tính Điểm";
"onboarding.page4.body" = "Hết quân bên phía bạn? Đối thủ phải cho bạn mượn 5 quân từ số đã ăn được — nếu không đủ, ván đấu kết thúc. Khi ván đấu kết thúc, quân trong các ô Quan (mỗi ô trị giá 10 điểm) thuộc về chủ ô. Ai ăn được nhiều quân nhất sẽ thắng.";
"onboarding.next" = "Tiếp Theo";
"onboarding.begin" = "Bắt Đầu Chơi";

