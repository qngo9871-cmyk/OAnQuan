"rules.title" = "Full Rules";
"rules.done" = "Done";
"rules.variant.title" = "Ô Ăn Quan (10-point quan variant)";
"rules.variant.body" = "This app uses the common convention where each Quan (mandarin) cell's large stone is worth 10 points at final scoring. Other sources vary on this value — this is the one this app uses, consistently.";
"rules.setup.title" = "The Board";
"rules.setup.body" = "12 cells in a loop: 2 large Quan cells at opposite ends, and 10 small dân cells split 5-and-5 between the two players. Each dân cell starts with 5 stones; each Quan cell starts with 1 large quan stone worth 10 points.";
"rules.sowing.title" = "Sowing (Rải)";
"rules.sowing.body" = "On your turn, pick up all the stones from one of your own non-empty dân cells. Choose a direction — clockwise or counter-clockwise — and drop one stone into each cell as you go around the loop, including Quan cells if you pass them.";
"rules.capture.title" = "Capturing (Ăn)";
"rules.capture.body" = "After sowing, look at the cell right after your last stone. If it's empty, look at the cell after that — if it has stones, you capture them all. Keep checking: as long as an empty cell is followed by a non-empty one, the chain continues. It stops at two empty cells in a row, or at a Quan cell (Quan cells can never be captured this way).";
"rules.borrow.title" = "Borrowing (Mượn)";
"rules.borrow.body" = "If all 5 of your dân cells are ever empty on your turn, your opponent must lend you 1 stone from their captured pile into each of your 5 cells. If they don't have at least 5 stones to lend, the game ends immediately.";
"rules.scoring.title" = "Scoring & Game End";
"rules.scoring.body" = "The game also ends if both players' rows are empty at the same time. Any stones left in the Quan cells (the 10-point quan stone plus whatever ordinary stones landed there) go to that cell's owner. Stones left in dân cells are discarded. Highest total captured score wins — ties are a draw.";

"onboarding.page1.title" = "The Board";
"onboarding.page1.body" = "Ô Ăn Quan is a traditional Vietnamese board game. 12 cells in a loop: your 5 dân cells, your opponent's 5 dân cells, and a large Quan cell at each end.";
"onboarding.page2.title" = "Pick Up & Sow";
"onboarding.page2.body" = "Tap one of your own non-empty dân cells to pick up all its stones, then choose a direction. You drop one stone into every cell as you go around the loop.";
"onboarding.page3.title" = "Capture (Ăn)";
"onboarding.page3.body" = "If the cell right after your last stone is empty and the cell beyond that has stones, you capture them! Keep chaining through empty-then-full pairs — a Quan cell or two empty cells in a row stops the chain.";
"onboarding.page4.title" = "Borrowing & Scoring";
"onboarding.page4.body" = "Run out of stones on your side? Your opponent must lend you 5 from their pile — or the game ends if they can't. When the game ends, the Quan cells' stones (worth 10 points each) go to their owners. Most captured stones wins.";
